# Optional. Lifts the GitHub API rate limit while the site builds, and grants
# access to private repos. Without it, project stats fall back to content.ts.
GITHUB_TOKEN=

# Needed for the contact form to actually send. Without all three, the form
# validates and then reports that it couldn't send.
# CONTACT_FROM must be an address on a domain verified with Resend.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Signs the contact form's timestamp, which is what catches bots that submit
# instantly. Falls back to a per-process random value, so anywhere that runs
# more than one instance (Netlify, Vercel, any scaled deploy) must set this, or
# a form rendered by one instance and submitted to another is read as a bot and
# the message is dropped without trace.
CONTACT_SECRET=
